; Godot Engine project configuration.
config_version=5

[application]

config/name="七日荒原"
config/description="穿过草甸、雪山与沙海，在第七夜守住营地，重新点亮荒原信标。"
config/version="0.6.6"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/use_custom_user_dir=true
config/custom_user_dir_name="SevenDaysToWasteland"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/min_width=960
window/size/min_height=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=18.0

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=false
textures/default_filters/anisotropic_filtering_level=0
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
anti_aliasing/quality/use_taa=false
lights_and_shadows/directional_shadow/size=1536
lights_and_shadows/directional_shadow/size.mobile=1024
environment/defaults/default_clear_color=Color(0.10, 0.078, 0.15, 1)

[layer_names]

3d_physics/layer_1="地貌"
3d_physics/layer_2="场景与方块"
3d_physics/layer_3="生物"
3d_physics/layer_4="载具"
3d_physics/layer_5="可拾取物"
