[sub_resource type="Shader" id="GridShader"]
code = "shader_type spatial;
varying vec2 floor_position;
void vertex() {
	floor_position = VERTEX.xz;
}
void fragment() {
	vec2 cells = floor_position * 2.0;
	vec2 line_distance = abs(fract(cells + 0.5) - 0.5) / max(fwidth(cells), vec2(0.0001));
	float grid = 1.0 - smoothstep(0.0, 1.25, min(line_distance.x, line_distance.y));
	ALBEDO = mix(vec3(0.11, 0.15, 0.17), vec3(0.20, 0.25, 0.26), grid);
	ROUGHNESS = 0.94;
}"

